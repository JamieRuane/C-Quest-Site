{
  "name": "code-quest",
  "private": true,
  "description": "Duolingo-style courses that teach C, Python, C++ and C# by doing.",
  "scripts": {
    "start": "node server.js",
    "verify": "node tools/verify.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-c-quest \"node --test tests/firestore.rules.test.js\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-c-quest",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "test:unit": "node --test tests/migrate.test.js",
    "test": "npm run test:unit && npm run verify"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.2.0",
    "firebase-tools": "^15.35.0"
  }
}
